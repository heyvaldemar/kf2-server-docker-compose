[Unit]
Description=Restart an empty Killing Floor 2 server closed to takeover

[Timer]
# Every five minutes: the rule waits fifteen minutes of a server seen empty
# and closed to takeover, so a run every five minutes acts within one period
# of that.
# In UTC. The night the clocks went back, the server this template comes
# from ran none of its local-time timers for an hour: systemd took the
# repeated hour as already gone. UTC has no repeated hour.
OnCalendar=*:2/5 UTC
# A net under the calendar: six minutes after the last run, so a missed run is
# made up within a minute. A run on time resets it before it fires.
OnUnitActiveSec=6min
# To the second, so the net's margin is real: the default accuracy is a
# minute.
AccuracySec=1s
Persistent=no

[Install]
WantedBy=timers.target
