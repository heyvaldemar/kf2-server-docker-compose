# Copy to .env beside the compose file, then edit. .env is gitignored.
#
# Nothing here is required: Killing Floor 2 has no rcon and no Steam token
# for a private server. The server name, mode, difficulty and length are in
# config/kf2server.cfg, and the WebAdmin password is set in-game on first use.

# ---------------------------------------------------------------- networking
# Game, query and Steam ports, each published under the number it binds.
# THE QUERY PORT is also written in config/kf2server.cfg (queryport=). Change
# it in both places or in neither: Steam records the port the server binds,
# and a remap on the outside sends players to a server that is not this one.
KF2_SERVER_GAME_PORT=7777
KF2_SERVER_QUERY_PORT=27015
KF2_SERVER_STEAM_PORT=20560

# WebAdmin, the only administrative interface the game has. Bound to this
# host by default. To reach it from your LAN, set the host's LAN address -
# never 0.0.0.0, which is the open internet.
KF2_SERVER_WEBADMIN_BIND=127.0.0.1
KF2_SERVER_WEBADMIN_PORT=8080

KF2_SERVER_TIMEZONE=UTC

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull.
#
# KF2_SERVER_IMAGE_VERSION=kf2@sha256:...
# KF2_SERVER_IMAGE_TAG=gameservermanagers/gameserver:kf2
#
# The uid/gid the server runs as, which is what owns the volume.
# KF2_SERVER_UID=1000
# KF2_SERVER_GID=1000
#
# Six players on Unreal Engine 3, with SteamCMD in the same container on
# every update. Raise it when a report shows it near the ceiling.
# KF2_SERVER_MEMORY_LIMIT=4g
# KF2_SERVER_CPU_LIMIT=2.0
# KF2_SERVER_MEMORY_RESERVATION=1g
# KF2_SERVER_CPU_RESERVATION=0.5
#
# The first start is a 25 GB SteamCMD download.
# KF2_SERVER_START_PERIOD=60m
# KF2_SERVER_STOP_GRACE_PERIOD=60s
# KF2_SERVER_LOG_MAX_SIZE=10m
# KF2_SERVER_LOG_MAX_FILE=3
